datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id                   String                 @id @default(cuid())
  name                 String
  location             String?
  startDate            DateTime?
  endDate              DateTime?
  createdAt            DateTime               @default(now())
  activities           ScheduleActivity[]
  documents            IngestionDocument[]
  progressEvents       ProgressEvent[]
  historicalExecutions HistoricalExecution[]
}

model ScheduleActivity {
  id              String             @id @default(cuid())
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityCode    String             // e.g. PIP-2401
  wbsCode         String             // e.g. 1.3.4.1
  name            String
  discipline      String             // Piping, Civil, Electrical, etc.
  plannedStart    DateTime
  plannedFinish   DateTime
  plannedDuration Int                // In days
  actualStart     DateTime?
  actualFinish    DateTime?
  quantity        Float?
  unit            String?
  location        String?
  status          String             @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETE, DELAYED
  matches         ActivityMatch[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model IngestionDocument {
  id               String          @id @default(cuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename         String
  sourceType       String          // TXT, CSV, XLSX, PDF, CHAT
  discipline       String?
  uploadedBy       String          @default("Site Supervisor")
  uploadedAt       DateTime        @default(now())
  rawContent       String?         @db.Text
  processingStatus String          @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, ERROR
  progressEvents   ProgressEvent[]
}

model ProgressEvent {
  id                   String             @id @default(cuid())
  documentId           String?
  document             IngestionDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  projectId            String
  project              Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  discipline           String
  activityDescription  String             @db.Text
  actualStart          DateTime?
  actualEnd            DateTime?
  quantity             Float?
  unit                 String?
  location             String?
  sourceText           String             @db.Text
  extractionConfidence Float              @default(0.9)
  status               String             @default("PROCESSED") // PROCESSED, LINKED, UNRESOLVED
  matches              ActivityMatch[]
  createdAt            DateTime           @default(now())
}

model ActivityMatch {
  id                 String           @id @default(cuid())
  progressEventId    String
  progressEvent      ProgressEvent    @relation(fields: [progressEventId], references: [id], onDelete: Cascade)
  scheduleActivityId String
  scheduleActivity   ScheduleActivity @relation(fields: [scheduleActivityId], references: [id], onDelete: Cascade)
  semanticScore      Float            @default(0.0)
  fuzzyScore         Float            @default(0.0)
  disciplineScore    Float            @default(0.0)
  locationScore      Float            @default(0.0)
  identifierScore    Float            @default(0.0)
  dateScore          Float            @default(0.0)
  finalConfidence    Float            @default(0.0)
  decision           String           // AUTO_LINK, NEEDS_REVIEW, UNMATCHED
  explanation        String           @db.Text
  reviews            PlannerReview[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model PlannerReview {
  id                 String        @id @default(cuid())
  matchId            String
  match              ActivityMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reviewerId         String        @default("Lead Planner")
  action             String        // APPROVED, REJECTED, REASSIGNED
  originalActivityId String?
  selectedActivityId String?
  reason             String?       @db.Text
  reviewedAt         DateTime      @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String   // ActivityMatch, ScheduleActivity, Document, Review
  entityId    String
  action      String   // AUTO_LINKED, PLANNER_APPROVED, PLANNER_REJECTED, REASSIGNED, CREATED
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  userId      String   @default("System AI")
  source      String   @default("AI") // AI, PLANNER, SYSTEM
  confidence  Float?
  explanation String?  @db.Text
  timestamp   DateTime @default(now())
}

model HistoricalExecution {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityId      String?
  discipline      String
  activityName    String
  plannedDuration Int
  actualDuration  Int
  variance        Int
  delayReason     String?  @db.Text
  contractor      String?
  quantity        Float?
  productivity    Float?
  createdAt       DateTime @default(now())
}
